{
  "meta": {
    "name": "AmeriLife Metadata Ecosystem \u2013 Nuclei View",
    "description": "Two-tier clustered graph. 5 balanced nuclei (data domains), each with 5-8 satellite systems. Faded inter-nucleus links represent cross-domain data flow and shared themes. Built from the real system inventory; each system keeps its originalGroup.",
    "format": "node-link (d3-force / react-force-graph / cytoscape / vis-network)",
    "tiers": {
      "nucleus": "cluster center (role=nucleus). Color purple, large val.",
      "satellite": "source system (role=satellite). Color teal, small val. Shares clusterId with its nucleus."
    },
    "edge_layers": {
      "intra": "nucleus \u2194 satellite. style=solid, opacity~0.9. Defines the nuclei.",
      "inter": "nucleus \u2194 nucleus. style=faded, opacity~0.18. The faint connecting lines."
    },
    "render_hints": {
      "cluster_with": "clusterId (use a clustering/grouping force, e.g. d3.forceX/Y per cluster or a custom many-body)",
      "size_with": "val (nucleus 18, satellite 6)",
      "fade_with": "link.opacity or link.style ('faded' => low alpha gray, 'solid' => bright)"
    },
    "counts": {
      "nuclei": 5,
      "satellites": 31,
      "intra_links": 31,
      "inter_links": 9
    },
    "satellites_per_nucleus": {
      "Policy & File Intake": 6,
      "Commission & Finance": 8,
      "Contracting & Licensing": 5,
      "CRM, Lead & Engagement": 7,
      "Master & Staging Data": 5
    }
  },
