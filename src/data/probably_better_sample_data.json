{
  "meta": {
    "name": "AmeriLife Source-System Metadata Graph",
    "description": "Force-directed graph of AmeriLife source systems built from the system inventory. System Groups are hubs, Source Systems are leaves, and fed Entities act as connectors that bridge clusters when shared across systems.",
    "format": "node-link (compatible with d3-force, react-force-graph, cytoscape, vis-network)",
    "legend": {
      "group": {
        "role": "hub / cluster center",
        "color": "#a855f7"
      },
      "system": {
        "role": "source system leaf",
        "color": "#5eead4"
      },
      "subsystem": {
        "role": "sub-feed of a parent system",
        "color": "#99f6e4"
      },
      "entity": {
        "role": "fed entity; shared entities bridge clusters",
        "color": "#f87171"
      }
    },
    "edge_types": [
      "belongs_to (system -> group)",
      "part_of (subsystem -> parent system)",
      "feeds (system -> entity)"
    ],
    "counts": {
      "nodes": 88,
      "links": 82,
      "groups": 12,
      "systems": 34,
      "entities": 42
    },
    "cross_cluster_bridges": [
      "Appointments",
      "Contract data",
      "Leads",
      "Policy data"
    ]
  },
